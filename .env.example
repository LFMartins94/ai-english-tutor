# ==============================================================================
# .env.example — template das variáveis de ambiente necessárias
# Copie este arquivo para `.env` e preencha com os seus valores reais.
# O arquivo `.env` NUNCA é versionado (está no .gitignore).
# ==============================================================================

# Chave de API da Groq (obtida em https://console.groq.com/keys)
# Usada pelo cliente LLM para autenticar as requisições
LLM_API_KEY=sua-chave-aqui

# Base URL da API — endpoint OpenAI-compatible da Groq
# Trocando esta URL + chave, você migra para outro provedor sem mudar código
LLM_BASE_URL=https://api.groq.com/openai/v1

# Identificador do modelo a ser usado pela API
# gpt-oss-120b: modelo open-weight da OpenAI hospedado pela Groq
LLM_MODEL=openai/gpt-oss-120b

# Modelo do Corrector — tarefa curta (JSON), 20B é 2x mais rápido e metade do preço
LLM_MODEL_CORRECTOR=openai/gpt-oss-20b

# URL de conexão com o PostgreSQL (driver psycopg v3 via SQLAlchemy)
# Formato: postgresql+psycopg://usuario:senha@host:porta/banco
# Local (Docker): container ai-english-tutor-pg, porta 5432
DATABASE_URL=postgresql+psycopg://tutor:tutor123@localhost:5432/ai_english_tutor
